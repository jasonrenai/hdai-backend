# Copy to .env and fill in values.

MONGODB_CONNECTION_STRING=mongodb://localhost:27017
DB_NAME=your_database_name
JWT_SECRET=generate-a-long-random-secret

# RapidAPI key (Real-Time Web Search + ScrapeNinja page scrape)
# RAPIDAPI_KEY=

# Page scrape provider: scrapeninja (default) | legacy (old AI Content Scraper, A/B only)
# SCRAPE_PROVIDER=scrapeninja
# SCRAPENINJA_THIN_CHARS=500
# SCRAPENINJA_JS_TIMEOUT=20
# SCRAPENINJA_ENABLE_JS_FALLBACK=true
# SCRAPENINJA_HTML_TRUNCATE_CHARS=100000

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional — subscription endpoints need this
# STRIPE_SECRET_KEY=

# Email: set false in local/dev to skip Postmark sends (default true if unset)
# EMAIL_SENDING_ENABLED=false
# Server API token (Postmark → Servers → API Tokens). Account API tokens cannot send mail.
# POSTMARK_SERVER_API_TOKEN=
